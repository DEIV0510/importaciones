# ---------------------------------------------------------------------------
# Variables del panel de administración
#
# En local: copia este archivo a `.env` y rellénalo.
# En Vercel: Settings → Environment Variables (marca Sensitive en las secretas).
#
# Genera las dos primeras con:  npm run admin:hash -- "tu-contraseña"
# ---------------------------------------------------------------------------

# Hash scrypt de la contraseña. La contraseña en claro no se guarda nunca.
ADMIN_PASSWORD_HASH=

# Clave para firmar las cookies de sesión. Mínimo 32 caracteres.
AUTH_SECRET=

# Usuario del panel (opcional; por defecto "admin").
ADMIN_USER=admin

# ---------------------------------------------------------------------------
# Publicación en GitHub
#
# Sin GITHUB_TOKEN el panel funciona igual pero escribe en el disco local,
# que es justo lo que se quiere al desarrollar.
#
# El token debe ser "fine-grained", con acceso SOLO a este repositorio y
# permiso de lectura y escritura en "Contents".
# ---------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_REPO=DEIV0510/importaciones
GITHUB_BRANCH=main

# Correo que aparecerá como autor de los commits del panel.
GIT_AUTHOR_EMAIL=panel@mundoimportaciones.local
